# URL da API usada pelo frontend em desenvolvimento local.
# Ajuste apenas se o backend estiver rodando em outra porta ou host.
VITE_API_URL=http://localhost:3333

# Ambientes publicados nao usam este arquivo:
#   producao -> .env.production (versionado): https://api.gforcecoach.com
#   dev      -> .env.development.local ou variavel no painel do host,
#               apontando para https://api-dev.gforcecoach.com
#
# VITE_API_URL e resolvida em tempo de BUILD e compilada dentro do bundle.
# Trocar a variavel no painel do host sem rebuildar nao muda o destino das
# chamadas - e preciso um novo build e um novo deploy.
