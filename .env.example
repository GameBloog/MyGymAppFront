# URL da API usada pelo frontend em desenvolvimento local.
# Ajuste apenas se o backend estiver rodando em outra porta ou host.
VITE_API_URL=http://localhost:3333

# Em producao, VITE_API_URL vem da configuracao do host (painel da Vercel),
# nao de arquivo no repositorio.
#
# Atencao: e resolvida em tempo de BUILD e compilada dentro do bundle. Trocar
# a variavel no painel sem disparar um novo build nao muda o destino das
# chamadas.
